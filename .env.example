# ============================================================
# LoL Recommender - Configuracion local
# Copia este archivo como .env y completa tus valores.
# NUNCA subas tu .env a git ni compartas tu API key.
# La API key NO se incluye en el .exe: se lee de este archivo
# o de variables de entorno en tiempo de ejecucion.
# ============================================================

# API key del portal de desarrolladores de Riot (https://developer.riotgames.com)
RIOT_API_KEY=RGAPI-tu-api-key

# Riot ID del jugador (GameName#TagLine)
GAME_NAME=TuNombre
TAG_LINE=LAN

# Routing de plataforma: la1, la2, na1, euw1, kr, ...
PLATFORM_ROUTING=la1
# Routing regional: americas, europe, asia
REGIONAL_ROUTING=americas

# Cola ranked: 420 = Solo/Duo, 440 = Flex
QUEUE_ID=420
# Cuantas partidas historicas descargar por ingesta
MATCH_COUNT=30

# --- Modelos por campeon -----------------------------------
# Campeon con el que estas a punto de jugar. Selecciona el modelo del
# registry por campeon (models/champions/<Campeon>/<TIER>/); si ya existe
# un modelo del parche actual NO se reentrena (caso OTP).
CHAMPION=Jhin
# Liga/tier del segmento de jugadores del historico: IRON, BRONZE, SILVER,
# GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
TARGET_TIER=GOLD
# Maximo de partidas historicas usadas por entrenamiento de campeon
CHAMPION_HISTORY_MATCHES=3000

# Idioma para Data Dragon (es_MX, es_ES, en_US, ...)
LANGUAGE=es_MX

# --- LLM opcional para el chat (lore y dudas abiertas) ------
# Proveedores con capa GRATUITA (sin tarjeta):
#   groq       -> key gratis en https://console.groq.com
#   gemini     -> key gratis en https://aistudio.google.com/apikey
#   openrouter -> cuenta en https://openrouter.ai (usa modelos ":free")
# openai (ChatGPT) tambien se soporta pero ES DE PAGO.
# Deja LLM_PROVIDER vacio para desactivarlo (el chat funciona igual).
# LLM_PROVIDER=groq
# LLM_API_KEY=tu-api-key
# LLM_MODEL=  # opcional; hay un modelo por defecto por proveedor

# Cada cuantos segundos se refresca la inferencia en vivo
REFRESH_SECONDS=15

# Servidor local. Con 127.0.0.1 solo esta PC puede entrar; con 0.0.0.0
# tambien el movil en la misma Wi-Fi (codigos QR en http://127.0.0.1:8000/qr).
APP_HOST=127.0.0.1
APP_PORT=8000

# Ruta a los CSV seed (opcional; por defecto ../Learning/lan_ranked_match_sample)
# SEED_DATA_DIR=C:/ruta/a/lan_ranked_match_sample

# Nivel de logs: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
